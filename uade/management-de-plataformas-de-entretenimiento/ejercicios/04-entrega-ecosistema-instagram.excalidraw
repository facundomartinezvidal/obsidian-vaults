		{
			"type": "text",
			"id": "XjqkdoaB",
			"x": 994.2156450765228,
			"y": 768.5890536793555,
			"width": 469.74388748276914,
			"height": 431.25,
			"angle": 0,
			"strokeColor": "#2C2C2C",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
