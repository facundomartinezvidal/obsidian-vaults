			"updated": 1776801224352,
			"link": null,
			"locked": false,
			"text": "Si d_i > j               →   C[i][j] = C[i−1][j]                                                    (moneda muy grande)",
			"fontSize": 13,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Si d_i > j               →   C[i][j] = C[i−1][j]                                                    (moneda muy grande)",
